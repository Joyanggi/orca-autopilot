{
  "model": "{{MODEL_MASTER}}",
  "effortLevel": "{{EFFORT_MASTER}}",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(orca skills get orchestration *)",
      "Bash(orca orchestration run-create *)",
      "Bash(orca orchestration run-current *)",
      "Bash(orca orchestration run-use *)",
      "Bash(orca orchestration run-show *)",
      "Bash(orca orchestration task-create *)",
      "Bash(orca orchestration task-list *)",
      "Bash(orca orchestration task-update *)",
      "Bash(orca orchestration worker-start *)",
      "Bash(orca orchestration worker-show *)",
      "Bash(orca orchestration worker-list *)",
      "Bash(orca orchestration worker-read *)",
      "Bash(orca orchestration worker-release *)",
      "Bash(orca orchestration send *)",
      "Bash(orca orchestration check *)",
      "Bash(orca orchestration reply *)",
      "Bash(orca orchestration ask *)",
      "Bash(orca orchestration inbox *)",
      "Bash(orca orchestration request-show *)",
      "Bash(orca orchestration gate-create *)",
      "Bash(orca orchestration gate-list *)",
      "Bash(git add -- *)",
      "Bash(git commit -m *)",
      "Bash(git cherry-pick *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin main)",
      "Bash(git push origin *:refs/heads/orca/*)",
      "Bash(gh pr create --repo {{GITHUB_REPO}} --base main --head orca/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash({{MERGE_BIN}} *)",
      "Bash(npm ci)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.codex/auth.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Bash(git commit --amen*)",
      "Bash(git commit * --amen*)",
      "Bash(git commit --no-verif*)",
      "Bash(git commit * --no-verif*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git * --no-index*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --textconv*)",
      "Bash(git diff /*)",
      "Bash(git diff * /*)",
      "Bash(git diff ~*)",
      "Bash(git diff * ~*)",
      "Bash(git diff ../*)",
      "Bash(git diff * ../*)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(REVIEW.md)",
      "Write(REVIEW.md)",
      "Edit(orca-autopilot.json)",
      "Write(orca-autopilot.json)"
    ]
  }
}
